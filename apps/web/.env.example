# Public Firebase web configuration (safe to expose; secured by Firestore/Storage rules + App Check).
# Copy to .env.local and fill with your project's values. NEVER put server-only secrets here —
# anything prefixed VITE_ is bundled into the client (SECURITY-ARCHITECTURE §9).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: App Check reCAPTCHA Enterprise site key (SECURITY-ARCHITECTURE §10)
VITE_APPCHECK_SITE_KEY=

# Optional: point the app at local Firebase emulators during development ("true" to enable)
VITE_USE_FIREBASE_EMULATORS=false
