# Public Firebase web configuration (safe to expose; secured by Firestore/Storage rules + App Check).
# Copy to .env.local and fill with your project's values. NEVER put server-only secrets here —
# anything prefixed VITE_ is bundled into the client (SECURITY-ARCHITECTURE §9).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The business this deployment serves (single-business today; multi-business ready — OQ-17).
VITE_BUSINESS_ID=hynish

# App Check reCAPTCHA Enterprise site key (production). Leave blank for emulator/dev.
VITE_APPCHECK_SITE_KEY=
# App Check debug token — DEVELOPMENT ONLY. Never set this in a production build.
VITE_APPCHECK_DEBUG_TOKEN=

# Point the app at local Firebase emulators during development ("true" to enable).
VITE_USE_FIREBASE_EMULATORS=false
